<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Controls.AccentCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        BackgroundColor="{Binding CardBackgroundColor, Source={x:Reference Root}, FallbackValue={StaticResource ParishSurface}}"
        Stroke="{Binding AccentColor, Source={x:Reference Root}, FallbackValue={StaticResource Gray300}}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12">

        <Grid ColumnDefinitions="6, *">

            <!-- Left Accent Bar -->
            <BoxView
                Grid.Column="0"
                Color="{Binding AccentColor, Source={x:Reference Root}, FallbackValue={StaticResource Primary}}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <!-- Card Content Container -->
            <Grid Grid.Column="1" Padding="16">
                <ContentPresenter Content="{Binding Content, Source={x:Reference Root}}" />
            </Grid>

        </Grid>
    </Border>
</ContentView>