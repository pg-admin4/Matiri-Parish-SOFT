<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MauiApp1.Controls.StatsCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        Stroke="{Binding AccentColor, Source={x:Reference Root}, FallbackValue={StaticResource Gray200}}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12"
        BackgroundColor="{Binding CardBackgroundColor, Source={x:Reference Root}, FallbackValue={StaticResource ParishSurface}}"
        Padding="12">

        <Grid ColumnDefinitions="4, *" ColumnSpacing="12">
            <!-- Accent Bar Indicator (Left) -->
            <BoxView Grid.Column="0" 
                     Color="{Binding AccentColor, Source={x:Reference Root}, FallbackValue={StaticResource Primary}}" 
                     CornerRadius="2" />

            <!-- Main Content Container -->
            <Grid Grid.Column="1" ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">

                <!-- Icon Container -->
                <Border Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        Padding="8"
                        BackgroundColor="{Binding IconBackgroundColor, Source={x:Reference Root}, FallbackValue={StaticResource Gray100}}"
                        VerticalOptions="Center"
                        HorizontalOptions="Start">
                    <ContentPresenter Content="{Binding IconContent, Source={x:Reference Root}}" />
                </Border>

                <!-- Text Labels Block -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Title, Source={x:Reference Root}}"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}"
                           FontAttributes="Bold" />

                    <Label Text="{Binding ValueText, Source={x:Reference Root}, FallbackValue='0'}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                           FontSize="11"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>