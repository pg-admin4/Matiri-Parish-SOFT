<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:MauiApp1.Behaviors"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.BaptismPage"
             Title="Baptism Registry"
             BackgroundColor="{StaticResource ParishBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" MaximumWidthRequest="800">

            <!-- Page Header -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,10,0,5">
                <Label Text="New Baptism Record" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource Primary}" 
                       HorizontalOptions="Center" />

                <Label Text="Enter sacramental details to register a new baptism" 
                       FontSize="13" 
                       TextColor="{StaticResource TextMuted}" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- 1. Person & Family Details Section -->
            <controls:AccentCard AccentColor="{StaticResource Primary}"
                                CardBackgroundColor="{StaticResource ParishSurface}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Person &amp; Family Details" 
                           FontAttributes="Bold" 
                           FontSize="16" 
                           TextColor="{StaticResource Primary}" />

                    <!-- First Name -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="FirstNameEntry" Placeholder="First Name" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Middle Name -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="MiddleNameEntry" Placeholder="Middle Name (Optional)" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Last Name -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="LastNameEntry" Placeholder="Last Name" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Date of Birth -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date of Birth:" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                            <DatePicker x:Name="DobPicker" Format="yyyy-MM-dd" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Place of Birth -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="PlaceOfBirthEntry" Placeholder="Place of Birth" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Jumuiya -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="JumuiyaEntry" Placeholder="Jumuiya / Small Christian Community Name" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Church / Prayer House Name -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="PrayerHouseEntry" Placeholder="Prayer House / Church Name" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Father's Name -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="FatherNameEntry" Placeholder="Father's Full Name" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Mother's Name -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="MotherNameEntry" Placeholder="Mother's Full Name" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>
                </VerticalStackLayout>
            </controls:AccentCard>

            <!-- 2. Sacrament Details Section -->
            <controls:AccentCard AccentColor="{StaticResource MarianBlue}"
                                CardBackgroundColor="{StaticResource ParishSurface}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Baptism Details" 
                           FontAttributes="Bold" 
                           FontSize="16" 
                           TextColor="{StaticResource MarianBlue}" />

                    <!-- Date of Baptism -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date of Baptism:" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                            <DatePicker x:Name="BaptismDatePicker" Format="yyyy-MM-dd" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Officiating Priest -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="OfficiatingPriestEntry" Placeholder="Officiating Priest / Minister" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Godparent 1 -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="Godparent1Entry" Placeholder="Godparent 1 (Sponsor)" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>

                    <!-- Godparent 2 -->
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                        <Entry x:Name="Godparent2Entry" Placeholder="Godparent 2 (Optional)" PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>
                </VerticalStackLayout>
            </controls:AccentCard>

            <!-- 3. Physical Ledger Cross-Reference Section -->
            <controls:AccentCard AccentColor="{StaticResource Secondary}"
                                CardBackgroundColor="{StaticResource ParishSurface}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Physical Ledger Reference" 
                           FontAttributes="Bold" 
                           FontSize="16" 
                           TextColor="{StaticResource Secondary}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                            <Entry x:Name="BookNumberEntry" Placeholder="Book No." PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent">
                                <Entry.Behaviors>
                                    <behaviors:UpperCaseBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>

                        <Border Grid.Column="1" Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                            <Entry x:Name="PageNumberEntry" Placeholder="Page No." PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" Keyboard="Numeric" BackgroundColor="Transparent" />
                        </Border>

                        <Border Grid.Column="2" Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource White}" Padding="8,2">
                            <Entry x:Name="EntryNumberEntry" Placeholder="Entry No." PlaceholderColor="{StaticResource Gray400}" TextColor="{StaticResource TextPrimary}" Keyboard="Numeric" BackgroundColor="Transparent" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </controls:AccentCard>

            <!-- Save Action Button & Status -->
            <Button x:Name="SaveButton"
                    Text="Save Baptism Record" 
                    Clicked="OnSaveBaptismClicked" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="{StaticResource White}" 
                    FontAttributes="Bold" 
                    HeightRequest="48"
                    CornerRadius="8"
                    Margin="0,10,0,0" />

            <Label x:Name="StatusLabel" 
                   HorizontalOptions="Center" 
                   TextColor="{StaticResource Success}" 
                   FontSize="14"
                   FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>