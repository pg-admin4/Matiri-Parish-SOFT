<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.ResetPasswordPage"
             Title="Reset Password"
             BackgroundColor="{StaticResource ParishBackground}">

    <ScrollView>
        <Grid Padding="20">
            <!-- Centered card container -->
            <Grid VerticalOptions="Center" HorizontalOptions="Center">

                <controls:AccentCard
                    WidthRequest="380"
                    AccentColor="{StaticResource Primary}"
                    CardBackgroundColor="{StaticResource ParishSurface}">

                    <VerticalStackLayout Spacing="16" Padding="8">

                        <!-- Header Section -->
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Set New Password" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}" 
                                   HorizontalOptions="Center" />

                            <Label Text="Please choose a strong password for your account." 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextMuted}" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- New Password Field -->
                        <Border Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="8,4">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Text="🔒" 
                                       VerticalOptions="Center" 
                                       Margin="4,0,8,0"
                                       TextColor="{StaticResource TextMuted}" />
                                <Entry Placeholder="New Password" 
                                       PlaceholderColor="{StaticResource Gray400}"
                                       Text="{Binding NewPassword}" 
                                       IsPassword="True"
                                       TextColor="{StaticResource TextPrimary}"
                                       Grid.Column="1" 
                                       BackgroundColor="Transparent" />
                            </Grid>
                        </Border>

                        <!-- Confirm New Password Field -->
                        <Border Stroke="{StaticResource Gray300}"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="8,4">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Text="🔒" 
                                       VerticalOptions="Center" 
                                       Margin="4,0,8,0"
                                       TextColor="{StaticResource TextMuted}" />
                                <Entry Placeholder="Confirm New Password" 
                                       PlaceholderColor="{StaticResource Gray400}"
                                       Text="{Binding ConfirmPassword}" 
                                       IsPassword="True"
                                       TextColor="{StaticResource TextPrimary}"
                                       Grid.Column="1" 
                                       BackgroundColor="Transparent" />
                            </Grid>
                        </Border>

                        <!-- Error Message Label -->
                        <Label Text="{Binding ErrorMessage}" 
                               TextColor="{StaticResource Error}" 
                               FontSize="13"
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center" />

                        <!-- Update Password Button -->
                        <Button Text="Update Password" 
                                Command="{Binding ResetPasswordCommand}" 
                                BackgroundColor="{StaticResource Primary}" 
                                TextColor="{StaticResource White}" 
                                HeightRequest="44" 
                                CornerRadius="8"
                                FontAttributes="Bold" />

                    </VerticalStackLayout>
                </controls:AccentCard>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>